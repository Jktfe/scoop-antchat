{
  "version": "0.1.0",
  "description": "Native Windows antchat \u2014 Tauri 2 + Svelte 5 (Scoop-distributed, unsigned per JWPK no-cert decision)",
  "homepage": "https://github.com/Jktfe/antchat-windows",
  "license": "MIT",
  "architecture": {
    "64bit": {
      "url": "https://github.com/Jktfe/antchat-windows/releases/download/v0.1.0/Antchat_0.1.0_x64-setup.exe#/setup.exe",
      "hash": "b46f90ae7956f50170188f7d8aba4c7f672ab29e5f9f34aed5e5c3b80b99520a"
    }
  },
  "installer": {
    "file": "setup.exe",
    "args": [
      "/S",
      "/D=$dir"
    ],
    "script": [
      "$candidates = @(",
      "  (Join-Path $env:LOCALAPPDATA 'Antchat'),",
      "  (Join-Path (Join-Path $env:LOCALAPPDATA 'Programs') 'Antchat')",
      ")",
      "$installed = $candidates | Where-Object { (Test-Path (Join-Path $_ 'ant-chat-desktop.exe') -PathType Leaf) } | Select-Object -First 1",
      "if ($installed -and !(Test-Path (Join-Path $dir 'ant-chat-desktop.exe') -PathType Leaf)) {",
      "  Copy-Item -Path (Join-Path $installed '*') -Destination $dir -Recurse -Force",
      "}",
      "if (!(Test-Path (Join-Path $dir 'ant-chat-desktop.exe') -PathType Leaf)) {",
      "  throw \"ant-chat-desktop.exe was not produced in $dir and was not found in Tauri default install locations: $($candidates -join ', ')\"",
      "}"
    ]
  },
  "uninstaller": {
    "file": "uninstall.exe",
    "args": [
      "/S"
    ]
  },
  "depends": "antchat",
  "bin": [
    [
      "ant-chat-desktop.exe",
      "antchat-app"
    ]
  ],
  "shortcuts": [
    [
      "ant-chat-desktop.exe",
      "Antchat"
    ]
  ],
  "checkver": "github",
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/Jktfe/antchat-windows/releases/download/v$version/Antchat_$version_x64-setup.exe#/setup.exe"
      }
    }
  },
  "notes": "Unsigned first Windows Tauri build. Install via Scoop; direct EXE launch may show SmartScreen."
}
